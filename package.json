{
  "name": "mcp-metadata-demo",
  "version": "1.0.0",
  "description": "Demo MCP server + MCP apps showing a rich-metadata strategy for AI tooling. Companion to the paper 'The Missing Layer'. Uses Dutch open building data (BAG + EP-Online) as the domain.",
  "type": "module",
  "bin": {
    "mcp-metadata-demo": "./dist/stdio.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:ui && tsc",
    "build:ui": "node scripts/build-ui.js",
    "start": "node dist/stdio.js",
    "dev": "tsx watch src/stdio.ts",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node --env-file=.env.local dist/stdio.js",
    "http": "node dist/http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "tsx scripts/smoke.ts 3543AR 1",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && firebase deploy --only functions:mcp",
    "deploy:setup-secret": "firebase functions:secrets:set EP_ONLINE_API_KEY",
    "logs": "firebase functions:log --only mcp",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-apps",
    "metadata-strategy",
    "rich-domain-tools",
    "self-describing-tools",
    "ai-tooling",
    "claude",
    "bag",
    "kadaster",
    "ep-online",
    "energielabel",
    "nederland",
    "dutch",
    "buildings"
  ],
  "author": {
    "name": "David Golverdingen",
    "email": "5216270+DaveGold@users.noreply.github.com",
    "url": "https://www.linkedin.com/in/davidgolverdingen/"
  },
  "homepage": "https://davidgolverdingen.nl/en",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaveGold/mcp-metadata-demo.git"
  },
  "bugs": {
    "url": "https://github.com/DaveGold/mcp-metadata-demo/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "firebase-functions": "^7.2.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.0",
    "@angular/build": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@modelcontextprotocol/inspector": "^0.14.0",
    "@sgratzl/chartjs-chart-boxplot": "^4.4.5",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/angular-table": "9.2.1",
    "@tanstack/table-core": "9.1.2",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.19.11",
    "@vitest/coverage-v8": "^4.1.8",
    "chart.js": "^4.5.1",
    "chartjs-chart-funnel": "^4.2.5",
    "chartjs-chart-graph": "^4.3.5",
    "chartjs-chart-matrix": "^3.0.4",
    "chartjs-chart-sankey": "^0.14.3",
    "chartjs-chart-treemap": "^3.1.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "leaflet": "^1.9.4",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.8.1",
    "tsx": "^4.20.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.8"
  }
}
