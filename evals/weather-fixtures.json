  "select_probe": {
    "_query": {
      "dateFrom": "2024-01-01",
      "dateTo": "2024-01-03",
      "select": [
        "date",
        "maxTemperature",
        "weather"
      ]
    },
    "_why": "Establishes the failure mode the select question is built on. `maxTemperature` and `weather` are plausible guesses and both are WRONG — the fields are `tempMax` and `weatherLabel`.",
    "records_returned": [
      {
        "date": "2024-01-01"
      },
      {
        "date": "2024-01-02"
      },
      {
        "date": "2024-01-03"
      }
    ],
    "alert": "select: ignored unknown field(s) [maxTemperature, weather]. Returned only: date.",
    "_what_this_means": "recordCount stays 3. The response still looks well-formed. Every requested VALUE is gone and only the alert says so. This is a silent-content failure, not an error — which is why guessing field names is unsafe rather than merely unlucky."
  },
  "payload_dial": {
    "_why": "open-questions.md Q9 needs a response big enough for distance to exist. get_building_profile cannot supply one; this tool can, over a 55x range, with the guidance held constant.",
    "full_record_chars": 200,
    "measured_on": "2024-01-01 and 2024-01-02, no select — 12 fields per record",
    "summaryOnly_true": "~1,300 chars (~330 tokens)",
    "select_3_fields_over_366_days": "~20,000 chars (~5,000 tokens)",
    "full_records_over_366_days": "~73,000 chars (~18,000 tokens)",
    "_caveat": "The last two are extrapolations from the measured per-record size, not captures. Measure them on the wire before quoting them in a result file."
  },
